# ==============================================================================
# Yosys Synthesis Script for OpenTarget-I3C (GF180MCU Dry Run)
# ==============================================================================

# 1. Read all SystemVerilog source files
read_verilog -sv src/i3c_apb_regs.sv
read_verilog -sv src/i3c_bus_det.sv
read_verilog -sv src/i3c_ccc_decoder.sv
read_verilog -sv src/i3c_fifo_cdc.sv
read_verilog -sv src/i3c_ibi_hj_ctrl.sv
read_verilog -sv src/i3c_protocol_fsm.sv
read_verilog -sv src/i3c_phy_frontend.sv
read_verilog -sv src/opentarget_i3c_top.sv

# 2. Elaborate the design hierarchy
hierarchy -check -top opentarget_i3c_top

# 3. Perform high-level generic synthesis
synth -top opentarget_i3c_top

# 4. Map flip-flops and logic to the GF180MCU standard cell library.
# NOTE: The IIC OSIC Tools image typically stores the PDK in /foss/pdks/.
# If you are using gf180mcuC instead of gf180mcuD, change the directory name below.
dfflibmap -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_1v80.lib
abc -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_1v80.lib

# 5. Clean up unused cells and wires
clean

# 6. Print design statistics and estimated area
stat -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_1v80.lib

# 7. Write the synthesized gate-level netlist (optional, but good for review)
write_verilog -noattr synth_opentarget_i3c_top_gates.v
